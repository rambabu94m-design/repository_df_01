{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DF-name-01"
		},
		"LS_ADLS_11_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_11'"
		},
		"LS_ADLS_11_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsname11.dfs.core.windows.net/"
		},
		"LS_azuredatabrick11_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1103-050539-a2tqux0i"
		},
		"LS_keyvault_11_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://keyvault-name-11.vault.azure.net/"
		},
		"LS_postgres_11_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-royal-scene-b47pbypg-pooler.c-6.us-east-2.aws.neon.tech"
		},
		"LS_postgres_11_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_postgres_11_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"LS_sqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "server-name-11.database.windows.net"
		},
		"LS_sqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DB-name-11"
		},
		"LS_sqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "test11"
		},
		"LS_tokenaccess_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://keyvault-name-11.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "DF-name-01_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_11_accountKey": {
						"value": "[parameters('LS_ADLS_11_accountKey')]"
					},
					"LS_ADLS_11_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_11_properties_typeProperties_url')]"
					},
					"LS_keyvault_11_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_keyvault_11_properties_typeProperties_baseUrl')]"
					},
					"LS_tokenaccess_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_tokenaccess_properties_typeProperties_baseUrl')]"
					},
					"LS_azuredatabrick11_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_azuredatabrick11_properties_typeProperties_existingClusterId')]"
					},
					"LS_postgres_11_properties_typeProperties_server": {
						"value": "[parameters('LS_postgres_11_properties_typeProperties_server')]"
					},
					"LS_postgres_11_properties_typeProperties_database": {
						"value": "[parameters('LS_postgres_11_properties_typeProperties_database')]"
					},
					"LS_postgres_11_properties_typeProperties_username": {
						"value": "[parameters('LS_postgres_11_properties_typeProperties_username')]"
					},
					"LS_sqldb_properties_typeProperties_server": {
						"value": "[parameters('LS_sqldb_properties_typeProperties_server')]"
					},
					"LS_sqldb_properties_typeProperties_database": {
						"value": "[parameters('LS_sqldb_properties_typeProperties_database')]"
					},
					"LS_sqldb_properties_typeProperties_userName": {
						"value": "[parameters('LS_sqldb_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}