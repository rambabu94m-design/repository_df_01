{
	"name": "PL_test",
	"properties": {
		"activities": [
			{
				"name": "Execute Pipeline success",
				"type": "ExecutePipeline",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "check for latest records",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "send mail pipeline",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"email_recipient": {
							"value": "rambabu94m@gmail.com",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute Pipeline_failure",
				"type": "ExecutePipeline",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "check for latest records",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "send mail pipeline",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"email_recipient": {
							"value": "rambabu94m@gmail.com",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "get meta data",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select watermark_datetime from WatermarkTable where table_name='@{toLower(pipeline().parameters.table_name)}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_source_21",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "check count",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "get meta data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select count(*) as count from @{pipeline().parameters.table_name} where datemodified>'@{activity('get meta data').output.firstRow.watermark_datetime}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_source_21",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "check for latest records",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "check count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(activity('check count').output.firstRow.count,0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "inject data",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select * from dbo.customer where datemodified>'@{activity('get meta data').output.firstRow.watermark_datetime}'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_source_21",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "DS_target_21",
									"type": "DatasetReference",
									"parameters": {
										"table_name": "customer"
									}
								}
							]
						},
						{
							"name": "update metadata",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "inject data",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_source_db_21",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update WatermarkTable \nset watermark_datetime =current_timestamp where table_name='@{pipeline().parameters.table_name}'",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"table_name": {
				"type": "string"
			}
		},
		"annotations": []
	}
}