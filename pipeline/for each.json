{
	"name": "for each",
	"properties": {
		"activities": [
			{
				"name": "ingest all tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "get list of tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('get list of tables').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Execute Pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_test",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_name": {
										"value": "@item().table_name",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "store tables success",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Execute Pipeline",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "table_variable",
								"value": {
									"value": "@{item().table_name}-success",
									"type": "Expression"
								}
							}
						},
						{
							"name": "store table failure",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Execute Pipeline",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "table_variable",
								"value": {
									"value": "@{item().table_name}-failure",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "get list of tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from dbo.metadata",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_source_21",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "consolidated email",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "ingest all tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "send mail pipeline",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"email_recipient": "rambabu94m@gmail.com",
						"table_status": {
							"value": "@variables('variable of all the tables')",
							"type": "Expression"
						}
					}
				}
			}
		],
		"variables": {
			"variable of all the tables": {
				"type": "Array"
			},
			"variables of all the tables failure": {
				"type": "Array"
			},
			"table_variable": {
				"type": "Array"
			}
		},
		"annotations": []
	}
}